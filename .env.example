# Copy this file to .env and replace the development-only secret.
DJANGO_SECRET_KEY=change-this-before-running
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 0.0.0.0 exposes the port on the host's network interfaces.
# Restrict access to the office private network with the host firewall.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8000

# 180 days. Deleting browser cookies issues a new Device ID later.
SESSION_COOKIE_AGE=15552000
TZ=Asia/Seoul
